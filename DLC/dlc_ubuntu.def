Bootstrap: localimage
From: ../visualization/vgl_base_ubuntu.sif

%post
    # Workarounds for Apptainer fakeroot builds
    cp /usr/bin/true /usr/sbin/groupadd
    cp /usr/bin/true /usr/sbin/useradd

    # Prevent services from starting during the build
    echo "exit 0" > /usr/sbin/policy-rc.d
    chmod +x /usr/sbin/policy-rc.d

    # GUI (Qt6/PySide6 + napari/vispy OpenGL) and video dependencies
    apt-get update
    apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv python3-dev build-essential \
        libgl1 libegl1 libopengl0 libgl1-mesa-dri \
        libx11-6 libx11-xcb1 libxext6 libxrender1 \
        libxi6 libxkbcommon0 libxkbcommon-x11-0 \
        libsm6 libice6 libfontconfig1 libdbus-1-3 \
        libxcb-cursor0 libxcb-xinerama0 libxcb-glx0 \
        libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-randr0 libxcb-render-util0 libxcb-shape0 \
        libxcb-xfixes0 libxcb-xkb1 \
        libglib2.0-0 libnss3 libasound2 \
        ffmpeg wget ca-certificates \
        && rm -rf /var/lib/apt/lists/*

    # DeepLabCut 3.x needs Python 3.10-3.12; fail fast if the base is too old
    python3 - <<'EOF'
import sys
if not (3, 10) <= sys.version_info[:2] <= (3, 12):
    sys.exit(f"DeepLabCut needs Python 3.10-3.12, base image has {sys.version}")
EOF

    python3 -m venv /opt/dlc-venv
    /opt/dlc-venv/bin/pip install --upgrade pip

    # Install PyTorch FIRST so DLC picks up the build you want.
    # No CUDA toolkit needed inside the image: the wheels bundle the CUDA
    # runtime libs; the host driver is injected at runtime via --nv.
    # GPU (CUDA 12.6 wheels, as in the DLC docs; adjust cuXXX to your driver):
    /opt/dlc-venv/bin/pip install torch torchvision --index-url https://download.pytorch.org/whl/cu126

    # DeepLabCut with the napari-based GUI
    /opt/dlc-venv/bin/pip install "deeplabcut[gui]==3.0.2"

    # Verify installation (import, not a --version CLI)
    /opt/dlc-venv/bin/python -c "import deeplabcut, torch; print('DLC', deeplabcut.__version__, '| torch', torch.__version__)"

%environment
    export PATH="/opt/dlc-venv/bin:$PATH"

%runscript
    exec vglrun_wrapper /opt/dlc-venv/bin/python -m deeplabcut "$@"