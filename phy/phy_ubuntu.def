
Bootstrap: localimage
From: ../visualization/vgl_base_ubuntu.sif

%post
    # Workarounds for Apptainer fakeroot builds
    cp /usr/bin/true /usr/sbin/groupadd
    cp /usr/bin/true /usr/sbin/useradd

    # Prevent services from starting during the build
    echo "exit 0" > /usr/sbin/policy-rc.d
    chmod +x /usr/sbin/policy-rc.d

    # GUI and Qt dependencies
    apt-get update
    apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv \
        libgl1 libegl1 libx11-6 libxext6 libxrender1 \
        libxi6 libxkbcommon0 libxkbcommon-x11-0 \
        libsm6 libice6 libfontconfig1 libdbus-1-3 \
        libxcb-cursor0 libxcb-xinerama0 \
        libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-randr0 libxcb-render-util0 libxcb-shape0 \
        libxcb-xfixes0 libxcb-xkb1 \
        libglib2.0-0 libnss3 libasound2 \
        wget ca-certificates \
        && rm -rf /var/lib/apt/lists/*

    # Install Phy
    python3 -m venv /opt/phy-venv
    /opt/phy-venv/bin/pip install --upgrade pip
    /opt/phy-venv/bin/pip install phy==2.1.0

    # Verify installation
    /opt/phy-venv/bin/phy --version

%environment
    export PATH="/opt/phy-venv/bin:$PATH"

%runscript
    exec vglrun_wrapper /opt/phy-venv/bin/phy "$@"
